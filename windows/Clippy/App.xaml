<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Clippy.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="ClippyBackgroundBrush" Color="#FF0A0A0A" />
            <SolidColorBrush x:Key="ClippySurfaceBrush" Color="#FF141414" />
            <SolidColorBrush x:Key="ClippySurfaceElevatedBrush" Color="#FF1F1F1F" />
            <SolidColorBrush x:Key="ClippyAccentBrush" Color="#FF2ED96B" />
            <SolidColorBrush x:Key="ClippyAccentDimBrush" Color="#FF1F8C47" />
            <SolidColorBrush x:Key="ClippyTextPrimaryBrush" Color="White" />
            <SolidColorBrush x:Key="ClippyTextSecondaryBrush" Color="#8CFFFFFF" />
            <SolidColorBrush x:Key="ClippyBorderBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
